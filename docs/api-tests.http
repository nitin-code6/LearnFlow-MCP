@baseUrl = http://localhost:5000/api
@token = your_jwt_token_here
@courseId = your_course_id_here
@lessonId = your_lesson_id_here

### 1. Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student2@learnflow.com",
  "password": "password123",
  "name": "New Student",
  "role": "STUDENT"
}

### 2. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "instructor@learnflow.com",
  "password": "hashed_password_here"
}

### 3. Create a course (Requires Instructor Token)
POST {{baseUrl}}/courses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Introduction to React",
  "description": "Learn React from scratch",
  "category": "Frontend",
  "thumbnail": "https://example.com/react.png"
}

### 4. Create a lesson (Requires Instructor Token)
POST {{baseUrl}}/courses/{{courseId}}/lessons
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Components and Props",
  "description": "Understanding React Components",
  "content": "A component is a reusable piece of UI...",
  "order": 1
}

### 5. Enroll in a course (Requires Student Token)
POST {{baseUrl}}/courses/{{courseId}}/enroll
Authorization: Bearer {{token}}

### 6. Mark lesson as complete (Requires Student Token)
POST {{baseUrl}}/lessons/{{lessonId}}/complete
Authorization: Bearer {{token}}

### 7. Check My Progress (Requires Student Token)
GET {{baseUrl}}/my-progress
Authorization: Bearer {{token}}
